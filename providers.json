{
  "_note": "通用 OpenAI 兼容通道。路由规则：优先看 model 里的 `provider/` 前缀；没有前缀则按本文件 models 列表匹配。api_key_env 填环境变量名，本地服务可留空。改完无需重启。",

  "_routing_example": [
    "ollama/qwen2.5:7b      → provider=ollama, 上游模型=qwen2.5:7b",
    "glm-4.5-air            → 命中 glm 的 models 列表，直接用短名",
    "relay/任意模型名        → 走自建中转，模型名原样透传"
  ],

  "ollama": {
    "base_url": "http://127.0.0.1:11434/v1",
    "api_key_env": "",
    "models": ["qwen2.5:7b", "qwen2.5:7b-fast", "qwen2.5vl:7b"]
  },

  "deepseek": {
    "base_url": "https://api.deepseek.com/v1",
    "api_key_env": "DEEPSEEK_API_KEY",
    "models": ["deepseek-flash", "deepseek-v4-pro"],
    "_legacy": "deepseek-chat / deepseek-reasoner 仍可调，但官方已改为重定向到 V4 系列并按新模型计费"
  },

  "glm": {
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "api_key_env": "GLM_API_KEY",
    "models": [
      "glm-4.7-flash",
      "glm-4.5-air",
      "glm-4.5",
      "glm-4.6",
      "glm-4.7",
      "glm-5",
      "glm-5-turbo"
    ]
  },

  "aistudio": {
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "api_key_env": "GOOGLE_AI_STUDIO_KEY",
    "models": ["gemini-2.5-flash", "gemini-2.5-pro", "gemini-2.0-flash"],
    "_note": "Google AI Studio（Gemini API）的 OpenAI 兼容端点；与走 Vertex 的 gemini-* 是两条独立计费链路。填好 key 后可用 `aistudio/gemini-2.5-flash` 调用；具体可用模型请先 GET /v1/models 核对。"
  },

  "siliconflow": {
    "base_url": "https://api.siliconflow.cn/v1",
    "api_key_env": "SILICONFLOW_API_KEY",
    "models": [
      "deepseek-ai/DeepSeek-V4.1-Flash",
      "zai-org/GLM-5.3-Flash",
      "zai-org/GLM-5.3",
      "meituan-longcat/LongCat-2.0"
    ]
  },

  "groq": {
    "base_url": "https://api.groq.com/openai/v1",
    "api_key_env": "GROQ_API_KEY",
    "models": ["openai/gpt-oss-20b", "allam-2-7b"]
  },

  "grok": {
    "base_url": "https://api.x.ai/v1",
    "api_key_env": "XAI_API_KEY",
    "models": [],
    "_status": "2026-10-21 实测 403：新 team 无 credits，需充值后才可调用"
  },

  "openai": {
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "models": ["gpt-5-nano"],
    "_status": "2026-10-21 实测 429 insufficient_quota：账号余额为 0，需充值"
  },

  "openrouter": {
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "headers": { "HTTP-Referer": "http://localhost", "X-Title": "local-proxy" },
    "models": [
      "minimax/minimax-m3.1-flash:free",
      "xingchen-agi/xing4.0-29b-a4b:free",
      "deepseek/deepseek-v4.1-flash-1017"
    ]
  },

  "relay": {
    "base_url": "",
    "api_key_env": "RELAY_API_KEY",
    "models": []
  }
}
