# ===== Vertex AI 配置 =====
# 必填：Google AI Studio / Agent Platform 创建的静态 API Key
# 形态可能是 AIza... 或 AQ.Ab8... 开头（本机实测为 AQ. 形态）
GEMINI_API_KEY=

# Agent Platform 类型的 Key 必须显式指定项目与区域，否则会被路由到 Key 的默认区域并 404
# 填控制台里的「项目 ID」（形如 gen-lang-client-0123456789），不是 12 位项目编号
# 本机实测：location 必须为 global，asia-southeast1 下没有 gemini-2.5-pro
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# 出站代理：Python 进程访问 Google 需要走 Clash（ZCode -> 本代理是 127.0.0.1，不受影响）
VERTEX_PROXY=http://127.0.0.1:7897

# 监听地址与端口（默认 127.0.0.1:4000）
PROXY_HOST=127.0.0.1
PROXY_PORT=4000

# 客户端不传 model 时使用的默认模型
DEFAULT_MODEL=gemini-2.5-pro

# ===== 出站脱敏（发往 Google 前替换密钥/口令/隐私，响应回来再还原） =====
# SANITIZE_ENABLED=1  总开关
# SANITIZE_SECRETS=1  密钥/令牌/私钥/密码/连接串口令
# SANITIZE_PII=1      邮箱/手机号/身份证/银行卡（Luhn 校验后）
# SANITIZE_NETWORK=0  IP 地址（写代码或调网络时建议关）
# SANITIZE_RESTORE=1  响应里把占位符还原成原文
# SANITIZE_DEBUG=0    打印脱敏后的出站内容（都是占位符，安全）
SANITIZE_ENABLED=1
SANITIZE_SECRETS=1
SANITIZE_PII=1
SANITIZE_NETWORK=0
SANITIZE_RESTORE=1
SANITIZE_DEBUG=0

# ===== 服务端内置工具代执行 =====
# ZCode 会把 Google:web_search / Google:python_interpreter 当普通函数发过来，
# 但前端没有实现（表现为"工具调用 执行失败"）。打开后由本代理用
# google_search / code_execution 代执行，再把结果回灌给模型。
# 代价：搜索类请求会多消耗 2 倍上游调用，配额紧张时可设为 0。
SERVER_TOOL_BRIDGE=1
BRIDGE_MAX_ROUNDS=3

# 桥接搜索固定使用的快模型（与对话模型解耦）
# 实测 gemini-4-argon 带 grounding 需 49~170 秒，用它会把客户端卡死
BRIDGE_SEARCH_MODEL=gemini-2.5-flash

# ===== 上游限流重试 =====
# 4-argon 配额很紧，容易 429。命中后自动退避重试，最多 RETRY_MAX_ATTEMPTS 次，
# 间隔 5s、10s、20s…（上限 RETRY_MAX_DELAY 秒）
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY=5
RETRY_MAX_DELAY=40

# ===== 日志 =====
# 写入 logs/proxy.log，按大小自动切分；总占用 ≈ LOG_MAX_MB × (LOG_BACKUPS + 1)
LOG_MAX_MB=5
LOG_BACKUPS=5
# 0 = 只打控制台（跑测试时用，避免污染生产日志）
LOG_TO_FILE=1

# ===== 启动前链路预检 =====
# 1 = 每次请求前先探本地代理端口 / Google 连通性；
# 不通就直接返回人话（不重试），避免无意义地等 30 秒
PREFLIGHT=1

# ===== 其它 provider 的 Key（走通用 OpenAI 兼容通道）=====
# 只填你要用的；providers.json 里 api_key_env 指向这些变量名
# DEEPSEEK_API_KEY=sk-...
# GLM_API_KEY=...
# XAI_API_KEY=xai-...
# OPENAI_API_KEY=sk-...
# RELAY_API_KEY=...
# 本地 Ollama 不需要 Key（base_url 指向 http://127.0.0.1:11434/v1）

# ===== 用量记账与限额 =====
# 账本：data/usage/YYYY-MM-DD.jsonl，每请求一行；USD 估算看 /stats
# warn = 超了只记日志（先观察用）；block = 软着陆拦截（见下）
LIMIT_MODE=block
RPM_LIMIT=30                 # 60 秒滑动窗口，超了立即 429（60 秒后恢复）

# 主口径：只算「未命中缓存」的输入 token（命中部分官方按 1 折计费）
DAILY_UNCACHED_LIMIT=5000000
# 兜底：总 token（in + out）上限
DAILY_TOKEN_LIMIT=10000000
DAILY_REQ_LIMIT=500          # 每日请求数
# 软着陆：额度用完后不掐当前会话，等下一段会话开始才拦。
# 例外：总量超过下面这个倍数时强制熔断（0 = 关闭该熔断）
LIMIT_HARD_MULTIPLIER=3

USAGE_KEEP_DAYS=14           # 账本保留天数

# 是否把 python_interpreter 也接到 Gemini 沙箱 code_execution。
# 默认关：沙箱能算但不会把文件写到本机，代执行会让模型误报"文件已生成"。
BRIDGE_CODE_EXEC=0

# 可选：思考预算。2.5-flash 可设 0；2.5-pro 最小 128，设 0 会 400
# THINKING_BUDGET=512
